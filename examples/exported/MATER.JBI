/JOB
//NAME MATER
//POS
///NPOS 0,0,0,0,0,0
//INST
///DATE 2024/08/22 15:47
///ATTR SC,RW
///GROUP1 RB1
NOP
CLEAR STACK
DOUT OT#(2) OFF
DOUT OT#(1) OFF
DOUT OT#(4) OFF
DOUT OT#(3) OFF
DIN B000 SOUT#(120)
*1
IFTHENEXP B000<>1
	 CALL JOB:HOME
ENDIF
IFTHENEXP B000=1
	 CLEAR I010 2
ELSEIFEXP B000<>1
	 JUMP *1
ENDIF
CALL JOB:SPEED-1
CALL JOB:POS-DATA
END
