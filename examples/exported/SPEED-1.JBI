/JOB
//NAME SPEED-1
//POS
///NPOS 0,0,0,0,0,0
//INST
///DATE 2024/08/22 15:59
///ATTR SC,RW
///GROUP1 RB1
NOP
'B005_speed from plc
DIN B005 IG#(2)
IFTHENEXP B005>1 ANDEXP B005<100
ELSEIFEXP B005<10
	 SET B005 10
	 DOUT OG#(2) B005
ENDIF
'I000_MOVJ low
'I001_MOVJ medium
'I002_MOVJ high
'I003_MOVL low
'I004_MOVL medium
'I005_MOVL high
SET I000  EXPRESS 5 * B005
SET I001  EXPRESS 10 * B005
SET I002  EXPRESS 15 * B005
SET I003  EXPRESS 20 * B005
SET I004  EXPRESS 25 * B005
SET I005  EXPRESS 30 * B005
END
